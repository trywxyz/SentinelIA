# ==========================================
# Sentinel IA - Master Gitignore
# ==========================================

# --- Java / Spring Boot (Backend) ---
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/resources/architecture/*.html

# Compilados e logs
*.class
*.marshalled
*.log
*.gz

# Pacotes pesados
*.jar
*.war
*.ear
*.zip
*.tar.gz

# Banco de Dados H2 (Ficheiros locais temporários se gravados em disco)
*.mv.db
*.trace.db

# --- Node / React (Frontend) ---
node_modules/
/frontend/build
.pnp
.pnp.js

# Logs do NPM
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDEs e Editores de Código (Geral) ---
.idea/
*.iml
.classpath
.project
.settings/
.vscode/
*.sublime-project
*.sublime-workspace

# --- Ficheiros do Sistema Operacional ---
.DS_Store
.DS_Store?
._*
Thumsc.db
ehthumbs.db
Desktop.ini

# --- Ficheiros de Configuração Sensíveis (Segurança) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Ajustes Finos de Produção para o Sentinel IA ---

# Frontend (React adicionais)
.eslintcache
.stylelintcache
frontend/coverage/

# Ferramentas locais e Containers (Caso inventes de usar Docker mais tarde)
.docker/
docker-compose.override.yml

# Ficheiros temporários de compilação da máquina local
*.swp
*~
.lock-wscript